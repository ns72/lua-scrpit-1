local NoclipConn, ZeroGravityConn = nil, nil

local function MatchFruit(name)
    if not name then return nil, nil end
    local clean = name:gsub("[%s%-_]",""):lower()
    for fruit, rank in pairs(FruitRanks) do
        if clean:find(fruit:lower()) then return fruit, rank end
    end
    return nil, nil
end

-- ========== ANTI-FLING & COLLISION DISABLER ==========
local function EnablePhysicsBypass()
    if not NoclipConn then
        NoclipConn = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if char then
                for _, v in pairs(char:GetChildren()) do
                    if v:IsA("BasePart") then v.CanCollide = false end
                end
            end
        end)
    end
    if not ZeroGravityConn then
        ZeroGravityConn = RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local hrp = char.HumanoidRootPart
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end
        end)
    end
end

local function DisablePhysicsBypass()
    if NoclipConn then NoclipConn:Disconnect() NoclipConn = nil end
    if ZeroGravityConn then ZeroGravityConn:Disconnect() ZeroGravityConn = nil end
end

-- ========== MEDIUM SERVER HOP (5-9 PLAYERS) ==========
local function ServerHop()
    if IsHopping then return end
    IsHopping = true
    
    local queueFunc = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport) or getgenv().queue_on_teleport
    if queueFunc then pcall(function() queueFunc(Settings.AutoExecuteScript) end) end

    task.spawn(function()
        while task.wait(2) do 
            local AllIDs = {}
            local success, result = pcall(function()
                return HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100"))
            end)
            
            if success and result and result.data then
                for _, s in pairs(result.data) do
                    if s.playing >= 5 and s.playing <= 9 and s.id ~= game.JobId then 
                        table.insert(AllIDs, s.id) 
                    end
                end
            end
            
            if #AllIDs > 0 then
                local RandomServer = AllIDs[math.random(1, #AllIDs)]
                pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, RandomServer, LocalPlayer) end)
                task.wait(5)
            end
        end
    end)
end

-- ========== COORDINATE TRACKING & SCANNER ==========
local function ScanFullMap()
    task.spawn(function()
        local newFruitList = {}
        local seen = {}
        
        for _, desc in ipairs(Workspace:GetChildren()) do
            if desc:IsA("Tool") or desc:IsA("Model") then
                local fName, fRank = MatchFruit(desc.Name)
                if fName and fRank and not seen[fName] then
                    local root = desc:FindFirstChild("Handle") or desc:FindFirstChild("MeshPart")
                    if root and root.Parent and root.Position.Y > -500 then
                        seen[fName] = true
                        table.insert(newFruitList, {Fruit = desc, Root = root, Name = fName, Rank = fRank})
                    end
                end
            end
        end
        
        table.sort(newFruitList, function(a,b) return a.Rank > b.Rank end)
        CachedFruits = newFruitList
        ScanCount = ScanCount + 1
        TotalFruitsFound = #newFruitList
    end)
end

local function SmoothDeltaFly(targetRoot)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid or not targetRoot then return end

    EnablePhysicsBypass()
    humanoid.PlatformStand = true

    local startPos = hrp.Position
    local targetPos = targetRoot.Position
    local skyY = math.max(startPos.Y, targetPos.Y) + Settings.SkyAltitude
    local waypoints = { 
        Vector3.new(startPos.X, skyY, startPos.Z), 
        Vector3.new(targetPos.X, skyY, targetPos.Z), 
        targetPos + Vector3.new(0, 1.5, 0) 
    }

    for _, point in ipairs(waypoints) do
        while hrp and hrp.Parent and targetRoot and targetRoot.Parent do
            local dist = (hrp.Position - point).Magnitude
            if dist < 5 then break end
            
            local dt = RunService.Heartbeat:Wait()
            local moveAmount = (point - hrp.Position).Unit * (Settings.FlySpeed * dt)
            hrp.CFrame = (dist <= moveAmount.Magnitude) and CFrame.new(point) or (hrp.CFrame + moveAmount)
        end
    end
    
    if humanoid then humanoid.PlatformStand = false end
    DisablePhysicsBypass()
end

-- ========== AUTO FARM LOGIC ==========
local function AutoFarmLogic()
    if not Settings.AutoFarmEnabled then IsFarmingFruit = false return end

    if TotalFruitsFound == 0 then
        if Settings.AutoHopEnabled and ScanCount > 2 then ServerHop() end
        IsFarmingFruit = false
        return
    end

    if IsFarmingFruit then return end
    IsFarmingFruit = true

    local targetData = CachedFruits[1] 
    if targetData and targetData.Root and targetData.Root.Parent then
        SmoothDeltaFly(targetData.Root)
        
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp and targetData.Root and targetData.Root.Parent then
            EnablePhysicsBypass()
            for i = 1, 3 do
                if not targetData.Root or not targetData.Root.Parent then break end
                hrp.CFrame = targetData.Root.CFrame
                firetouchinterest(targetData.Root, hrp, 0)
                task.wait(0.05)
                if targetData.Root and targetData.Root.Parent then firetouchinterest(targetData.Root, hrp, 1) end
            end
            DisablePhysicsBypass()
        end
        
        -- حذف من الكاش فوراً لمنع التكرار والكراش
        table.remove(CachedFruits, 1)
        TotalFruitsFound = #CachedFruits
        task.wait(1) 
        
        local CommF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
        if CommF then
            local function Store(item)
                if item:IsA("Tool") then pcall(function() CommF:InvokeServer("StoreFruit", item:GetAttribute("OriginalName") or item.Name, item) end) end
            end
            for _, item in ipairs(LocalPlayer.Backpack:GetChildren()) do Store(item) end
            if char then for _, item in ipairs(char:GetChildren()) do Store(item) end end
        end
    end
    IsFarmingFruit = false
end

