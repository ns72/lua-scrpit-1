local FruitRanks = {
    ["Rocket"]=1, ["Spin"]=2, ["Spring"]=4, ["Bomb"]=5, ["Smoke"]=6, ["Spike"]=7, 
    ["Flame"]=8, ["Ice"]=9, ["Sand"]=10, ["Dark"]=11, ["Diamond"]=13, ["Light"]=14, 
