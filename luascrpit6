-- [ 5. التنقل بين السيرفرات Server Hop ]
local function ServerHop()
    StatusLabel.Text = "جاري الانتقال لسيرفر جديد..."
    local PlaceId = game.PlaceId
    
    pcall(function()
        local servers = HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
        if servers and servers.data then
            for _, server in ipairs(servers.data) do
                if server.playing < server.maxPlayers - 1 and server.id ~= game.JobId then
                    TeleportService:TeleportToPlaceInstance(PlaceId, server.id, LocalPlayer)
                    task.wait(4)
                    break
                end
            end
        end
    end)
    
    task.wait(1)
    pcall(function() TeleportService:Teleport(PlaceId, LocalPlayer) end)
end

-- [ 6. البحث عن البوس ]
local function GetGorillaKing()
    local enemies = workspace:FindFirstChild("Enemies")
    if enemies then
        for _, enemy in pairs(enemies:GetChildren()) do
            if enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
                if string.find(string.lower(enemy.Name), "gorilla king") then
                    return enemy
                end
            end
        end
    end
    for _, enemy in pairs(workspace:GetChildren()) do
        if enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
            if string.find(string.lower(enemy.Name), "gorilla king") then
                return enemy
            end
        end
    end
    return nil
end

-- [ 7. التسلسل التشغيلي ]
task.spawn(function()
    AutoJoinMarines()
    if not AutoFarm then return end
    
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    if hrp then
        -- ترك الأسلحة (الأيدي فارغة)
        if char:FindFirstChildOfClass("Humanoid") then
            char:FindFirstChildOfClass("Humanoid"):UnequipTools()
        end
        
        -- 1. الطيران إلى موقع جزيرة بوس القرود
        StatusLabel.Text = "جاري الطيران إلى جزيرة القرود..."
        FlyTo(GorillaSpawnCFrame)
        
        task.wait(1) -- مهلة بسيطة لتحميل مجسمات الجزيرة
        
        -- 2. فحص وجود البوس
        local boss = GetGorillaKing()
        
        if boss and boss:FindFirstChild("HumanoidRootPart") and boss.Humanoid.Health > 0 then
            StatusLabel.Text = "البوس موجود! الطيران أمامه للتلفيل..."
            
            -- الطيران مباشرة لموقع البوس
            FlyTo(boss.HumanoidRootPart.CFrame * CFrame.new(0, 0, 4))
            
            -- التثبيت وإلغاء التصادم أثناء الضرب
            local connection
            connection = RunService.Heartbeat:Connect(function()
                if not AutoFarm or not boss or not boss:FindFirstChild("HumanoidRootPart") or boss.Humanoid.Health <= 0 then
                    if connection then connection:Disconnect() end
                    return
                end
                for _, part in pairs(char:GetChildren()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
                hrp.CFrame = boss.HumanoidRootPart.CFrame * CFrame.new(0, 0, 4)
            end)
            
            -- تفعيل الهاكي
            task.wait(0.3)
            VirtualInputManager:SendKeyEvent(true, HakiKey, false, game)
            task.wait(0.1)
            VirtualInputManager:SendKeyEvent(false, HakiKey, false, game)
            
            -- فترة استهلاك المراوغات (8.5 ثوانٍ)
            task.wait(8.5)
            
            if connection then connection:Disconnect() end
            if AutoFarm then ServerHop() end
        else
            -- إذا البوس غير موجود يغير السيرفر فوراً
            StatusLabel.Text = "البوس غير موجود! تغيير السيرفر..."
            task.wait(0.5)
            if AutoFarm then ServerHop() end
        end
    end
end)
