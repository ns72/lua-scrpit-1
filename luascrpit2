-- ========== HELPERS ==========
local function GetRootPart(item)
    if not item or not item.Parent then return nil end
    return item:FindFirstChild("Handle") or item:FindFirstChild("MeshPart") or item:FindFirstChild("Base") or item:FindFirstChildOfClass("BasePart")
end

local function MatchFruit(name)
    if not name then return nil, nil end
    local clean = name:gsub("%s+",""):gsub("%-",""):gsub("%_",""):lower()
    for fruit, rank in pairs(FruitRanks) do
        if clean:find(fruit:lower()) then return fruit, rank end
    end
    return nil, nil
end

-- ========== PHYSICS & BYPASS ==========
local function EnablePhysicsBypass()
    if not NoclipConn then
        NoclipConn = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if char then
                for _, v in pairs(char:GetChildren()) do
                    if v:IsA("BasePart") then v.CanCollide = false end
                end
            end
        end)
    end
    if not ZeroGravityConn then
        ZeroGravityConn = RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local hrp = char.HumanoidRootPart
                hrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
                hrp.AssemblyAngularVelocity = Vector3.new(0,0,0)
            end
        end)
    end
end

local function DisablePhysicsBypass()
    if NoclipConn then NoclipConn:Disconnect() NoclipConn = nil end
    if ZeroGravityConn then ZeroGravityConn:Disconnect() ZeroGravityConn = nil end
end

-- ========== SERVER HOP ==========
local function ServerHop()
    if IsHopping then return end
    IsHopping = true
    
    local queueFunc = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport) or getgenv().queue_on_teleport
    if queueFunc then pcall(function() queueFunc(Settings.AutoExecuteScript) end) end

    local PlaceID = game.PlaceId
    task.spawn(function()
        while task.wait(5) do
            local AllIDs = {}
            local success, result = pcall(function()
                return HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/"..PlaceID.."/servers/Public?sortOrder=Asc&limit=100"))
            end)
            if success and result and result.data then
                for _, s in pairs(result.data) do
                    if s.playing < s.maxPlayers - 1 and s.id ~= game.JobId then table.insert(AllIDs, s.id) end
                end
            end
            if #AllIDs > 0 then
                pcall(function() TeleportService:TeleportToPlaceInstance(PlaceID, AllIDs[math.random(1, #AllIDs)], LocalPlayer) end)
            else
                pcall(function() TeleportService:Teleport(PlaceID, LocalPlayer) end)
            end
        end
    end)
end

-- ========== OPTIMIZED SCANNER & ESP ==========
local function ScanFullMap()
    if ScanInProgress then return end
    ScanInProgress = true
    
    task.spawn(function()
        local newFruitList = {}
        local seen = {}
        
        -- الفحص في Workspace بشكل عام للبحث عن الفواكه المترسبة
        for _, desc in ipairs(Workspace:GetChildren()) do
            if desc and (desc:IsA("Tool") or desc:IsA("Model")) then
                local fruitName, rank = MatchFruit(desc.Name)
                if fruitName and rank and not seen[fruitName] then
                    local root = GetRootPart(desc)
                    if root and root.Parent and root.Position.Y > -500 then
                        local dist = (root.Position - PlayerPos).Magnitude
                        seen[fruitName] = true
                        table.insert(newFruitList, {Fruit = desc, Root = root, Name = fruitName, Rank = rank, Dist = dist})
                    end
                end
            end
        end
        
        table.sort(newFruitList, function(a,b) return a.Rank > b.Rank end)
        
        -- تنظيف الـ ESP للقديم
        for fruitInstance, esp in pairs(ESPObjects) do
            if not fruitInstance or not fruitInstance.Parent or not esp.FruitData.Root or not esp.FruitData.Root.Parent then
                if esp.Billboard then esp.Billboard:Destroy() end
                if esp.Highlight then esp.Highlight:Destroy() end
                ESPObjects[fruitInstance] = nil
            end
        end
        
        -- إنشاء الـ ESP الجديد
        for _, fruitData in ipairs(newFruitList) do
            if not ESPObjects[fruitData.Fruit] then
                -- Highlight لتمييز الفاكهة بوضوح
                local hl = Instance.new("Highlight")
                hl.Name = "FruitHighlight"
                hl.FillColor = Settings.ESPColor
                hl.OutlineColor = Color3.new(1, 1, 1)
                hl.FillTransparency = 0.5
                hl.OutlineTransparency = 0
                hl.Adornee = fruitData.Fruit
                hl.Parent = fruitData.Fruit
                
                -- Billboard بسيط بدون تعقيدات Frame
                local billboard = Instance.new("BillboardGui")
                billboard.Name = "FruitTextESP"
                billboard.AlwaysOnTop = true
                billboard.Size = UDim2.new(0, 200, 0, 50)
                billboard.StudsOffset = Vector3.new(0, 3, 0)
                billboard.Adornee = fruitData.Root
                billboard.Parent = fruitData.Root
                
                local label = Instance.new("TextLabel", billboard)
                label.BackgroundTransparency = 1
                label.Size = UDim2.new(1, 0, 1, 0)
                label.Font = Enum.Font.GothamBlack
                label.TextColor3 = Settings.ESPColor
                label.TextStrokeTransparency = 0
                label.TextStrokeColor3 = Color3.new(0, 0, 0)
                label.TextScaled = false
                label.TextSize = 16
                label.Text = "🍈 " .. fruitData.Name
                
                ESPObjects[fruitData.Fruit] = {Billboard = billboard, Highlight = hl, Label = label, FruitData = fruitData}
            end
        end
        
        CachedFruits = newFruitList
        ScanCount = ScanCount + 1
        TotalFruitsFound = #newFruitList
        
        -- التحكم بـ ESP الظهور
        for _, esp in pairs(ESPObjects) do
            esp.Billboard.Enabled = Settings.ESPEnabled
            esp.Highlight.Enabled = Settings.ESPEnabled
        end

        ScanInProgress = false
    end)
end

local function UpdateAllDistances()
    for fruitInstance, esp in pairs(ESPObjects) do
        if fruitInstance and esp.FruitData and esp.FruitData.Root and esp.FruitData.Root.Parent then
            local dist = (esp.FruitData.Root.Position - PlayerPos).Magnitude
            if esp.Label then
                esp.Label.Text = string.format("🍈 %s [%dm]", esp.FruitData.Name, math.floor(dist))
            end
        end
    end
end

-- ========== FLY ENGINE ==========
local function SmoothDeltaFly(targetWorldPos)
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end

    EnablePhysicsBypass()
    humanoid.PlatformStand = true

    local startPos = hrp.Position
    local skyY = math.max(startPos.Y, targetWorldPos.Y) + Settings.SkyAltitude
    local waypoints = { Vector3.new(startPos.X, skyY, startPos.Z), Vector3.new(targetWorldPos.X, skyY, targetWorldPos.Z), targetWorldPos + Vector3.new(0, 2, 0) }

    for _, point in ipairs(waypoints) do
        while hrp and hrp.Parent and (hrp.Position - point).Magnitude > 5 do
            if not Settings.AutoFarmEnabled then break end
            local dt = RunService.Heartbeat:Wait()
            if not hrp or not hrp.Parent then break end
            local dir = (point - hrp.Position).Unit
            local moveAmount = dir * (Settings.FlySpeed * dt)
            if (hrp.Position - point).Magnitude <= moveAmount.Magnitude then
                hrp.CFrame = CFrame.new(point)
                break
            else
                hrp.CFrame = hrp.CFrame + moveAmount
            end
        end
    end
    if humanoid then humanoid.PlatformStand = false end
    DisablePhysicsBypass()
end

-- ========== SAFE AUTO FARM ==========
local function StoreAllFruitsInBag()
    local CommF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
    if not CommF then return end
    local function storeItem(item)
        if item and item:IsA("Tool") then
            local fName, fRank = MatchFruit(item.Name)
            if fName or item.Name:lower():find("fruit") then
                pcall(function() CommF:InvokeServer("StoreFruit", item:GetAttribute("OriginalName") or item.Name, item) end)
            end
        end
    end
    for _, item in ipairs(LocalPlayer.Backpack:GetChildren()) do storeItem(item) end
    if LocalPlayer.Character then for _, item in ipairs(LocalPlayer.Character:GetChildren()) do storeItem(item) end end
end

local function AutoFarmLogic()
    if not Settings.AutoFarmEnabled then return end

    -- === نظام الـ Server Hop بانتظار 15 ثانية ===
    if TotalFruitsFound == 0 then
        if FruitlessStartTime == 0 then
            FruitlessStartTime = tick() -- بدء العداد
        elseif (tick() - FruitlessStartTime) >= 15 then
            if Settings.AutoHopEnabled then ServerHop() end
        end
        return
    else
        FruitlessStartTime = 0 -- تصفير العداد فور رؤية فاكهة
    end

    if IsFarmingFruit then return end
    IsFarmingFruit = true

    local targetFruit = CachedFruits[1] 
    if targetFruit and targetFruit.Root and targetFruit.Root.Parent then
        SmoothDeltaFly(targetFruit.Root.Position)
        
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local hrp = char.HumanoidRootPart
            EnablePhysicsBypass()
            for i = 1, 3 do
                if not targetFruit.Root or not targetFruit.Root.Parent then break end
                hrp.CFrame = targetFruit.Root.CFrame
                firetouchinterest(targetFruit.Root, hrp, 0)
                task.wait(0.05)
                if targetFruit.Root and targetFruit.Root.Parent then firetouchinterest(targetFruit.Root, hrp, 1) end
            end
            DisablePhysicsBypass()
        end
        
        task.wait(1.5)
        local currentChar = LocalPlayer.Character
        if currentChar then
            for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
                if tool:IsA("Tool") and (MatchFruit(tool.Name) or tool.Name:lower():find("fruit")) then
                    local hum = currentChar:FindFirstChildOfClass("Humanoid")
                    if hum then hum:EquipTool(tool) task.wait(0.2) end
                end
            end
        end
        StoreAllFruitsInBag()
    end
    IsFarmingFruit = false
end

